@{
    ViewData["Title"] = "Available Rides";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Available Rides</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            background: #222;
            color: #fff;
            font-family: 'Poppins', sans-serif;
        }

        .container {
            max-width: 700px;
            margin: 40px auto;
            background: #333;
            border-radius: 10px;
            padding: 30px;
        }

        h2 {
            color: #FFD700;
            text-align: center;
        }

        .ride-list {
            list-style: none;
            padding: 0;
        }

            .ride-list li {
                background: #222;
                margin-bottom: 18px;
                padding: 18px;
                border-radius: 8px;
            }

            .ride-list strong {
                color: #FFD700;
            }

        .accept-btn {
            background: #FFD700;
            color: #222;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 10px 18px;
            cursor: pointer;
            margin-top: 10px;
        }

            .accept-btn:hover {
                background: #e6c200;
            }

        .complete-btn {
            background: #28a745;
            color: white;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 10px 18px;
            cursor: pointer;
            margin-top: 10px;
        }

            .complete-btn:hover {
                background: #218838;
            }

        #rideStatus {
            margin-top: 30px;
            font-size: 18px;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: bold;
            margin-left: 10px;
        }

        .status-pending {
            background: #ffc107;
            color: #212529;
        }

        .status-inprogress {
            background: #17a2b8;
            color: white;
        }

        .status-completed {
            background: #28a745;
            color: white;
        }

        #chatSection {
            background: #222;
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            display: none;
        }

        #chatMessages {
            height: 300px;
            overflow-y: auto;
            padding: 10px;
            background: #1a1a1a;
            border-radius: 5px;
            margin-bottom: 10px;
            border: 1px solid #444;
        }

        .chat-message {
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            max-width: 80%;
        }

        .from-driver {
            background: #0062cc;
            color: white;
            margin-left: auto;
        }

        .from-passenger {
            background: #444;
            color: white;
            margin-right: auto;
        }

        .message-sender {
            font-weight: bold;
            font-size: 0.9em;
            margin-bottom: 3px;
        }

        .message-text {
            margin: 5px 0;
        }

        .message-time {
            font-size: 0.7em;
            opacity: 0.8;
            text-align: right;
        }

        #chatInput {
            background: #333;
            color: white;
            border: 1px solid #444;
            padding: 10px;
            border-radius: 5px;
            width: 100%;
        }

        #sendMessageBtn {
            background: #FFD700;
            color: #222;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 10px 18px;
            cursor: pointer;
            margin-top: 10px;
            width: 100%;
        }

            #sendMessageBtn:hover {
                background: #e6c200;
            }

        .connection-status {
            padding: 8px;
            border-radius: 4px;
            margin-bottom: 10px;
            text-align: center;
            display: none;
        }

        .connection-connected {
            background-color: #28a745;
            color: white;
        }

        .connection-error {
            background-color: #dc3545;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Available Rides</h2>
        <div id="connectionStatus" class="connection-status"></div>
        <div id="ridesList"></div>
        <div id="rideStatus"></div>
        <div id="activeRideControls" style="display: none;">
            <button id="completeRideBtn" class="complete-btn">Complete Ride</button>
            <div id="chatSection">
                <h4>Chat with Passenger</h4>
                <div id="chatMessages" class="d-flex flex-column"></div>
                <input type="text" id="chatInput" class="form-control" placeholder="Type a message..." />
                <button id="sendMessageBtn" class="btn btn-warning mt-2">Send</button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let currentRideId = null;
        let signalRConnection = null;
        let chatConnection = null;
        const userId = '@User.FindFirst(ClaimTypes.NameIdentifier)?.Value';

        function showConnectionStatus(message, isError = false) {
            const statusElement = document.getElementById("connectionStatus");
            statusElement.textContent = message;
            statusElement.className = isError ? "connection-status connection-error" : "connection-status connection-connected";
            statusElement.style.display = "block";

            if (!isError) {
                setTimeout(() => {
                    statusElement.style.display = "none";
                }, 3000);
            }
        }

        function renderAvailableRides(rides) {
            const ridesList = document.getElementById('ridesList');
            if (!rides || rides.length === 0) {
                ridesList.innerHTML = '<p>No available rides at the moment.</p>';
                return;
            }

            let html = '<ul class="ride-list">';
            for (const r of rides) {
                const rideTime = r.rideDateTime ? new Date(r.rideDateTime).toLocaleString() : '';
                const statusBadge = `<span class="status-badge status-${r.status.toLowerCase()}">${r.status}</span>`;

                html += `<li>
                    <strong>Pickup:</strong> ${r.pickupLocation}<br>
                    <strong>Dropoff:</strong> ${r.dropOffLocation}<br>
                    <strong>Requested:</strong> ${rideTime} ${statusBadge}<br>`;

                if (r.status === "Pending") {
                    html += `<button class="accept-btn" onclick="acceptRide(${r.rideID})">Accept & Start Ride</button>`;
                }

                html += `</li>`;
            }
            html += '</ul>';
            ridesList.innerHTML = html;
        }

        async function loadAvailableRides() {
            try {
                const res = await fetch('/Ride/GetAvailableRides');
                if (!res.ok) throw new Error('Failed to load rides');
                const rides = await res.json();
                renderAvailableRides(rides);
            } catch (error) {
                console.error('Error loading rides:', error);
                document.getElementById('ridesList').innerHTML = '<p>Error loading available rides. Please try again.</p>';
            }
        }

        async function acceptRide(rideId) {
            try {
                const res = await fetch('/Ride/AcceptRide', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ rideId })
                });

                if (!res.ok) throw new Error(await res.text() || 'Failed to accept ride');

                currentRideId = rideId;
                document.getElementById('ridesList').innerHTML = '<p>Ride accepted! Ride is now in progress.</p>';
                document.getElementById('rideStatus').innerHTML = '<span class="status-badge status-inprogress">🚕 Ride Status: InProgress</span>';
                document.getElementById('activeRideControls').style.display = 'block';

                startSignalR(rideId);
                startChatConnection(rideId);
                document.getElementById("chatSection").style.display = "block";

                loadAvailableRides();
            } catch (error) {
                console.error('Error accepting ride:', error);
                alert('Could not accept ride: ' + error.message);
            }
        }

        async function completeRide() {
            if (!currentRideId) return;

            try {
                const res = await fetch('/Ride/CompleteRide', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ rideId: currentRideId })
                });

                if (!res.ok) throw new Error(await res.text() || 'Failed to complete ride');

                document.getElementById('rideStatus').innerHTML = '<span class="status-badge status-completed">✅ Ride Status: Completed</span>';
                document.getElementById('activeRideControls').style.display = 'none';
                currentRideId = null;

                if (chatConnection) {
                    await chatConnection.stop();
                    chatConnection = null;
                }

                loadAvailableRides();
            } catch (error) {
                console.error('Error completing ride:', error);
                alert('Could not complete ride: ' + error.message);
            }
        }

        function startSignalR(rideId) {
            if (signalRConnection) return;

            signalRConnection = new signalR.HubConnectionBuilder()
                .withUrl("/rideHub")
                .withAutomaticReconnect()
                .build();

            signalRConnection.on("ReceiveRideStatus", function (status) {
                let statusClass = 'status-inprogress';
                if (status === "Completed") statusClass = 'status-completed';
                if (status === "Cancelled") statusClass = 'status-cancelled';

                document.getElementById('rideStatus').innerHTML =
                    `<span class="status-badge ${statusClass}">🚕 Ride Status: ${status}</span>`;

                if (status === "Completed") {
                    document.getElementById('activeRideControls').style.display = 'none';
                    currentRideId = null;
                }
            });

            signalRConnection.start()
                .then(() => {
                    signalRConnection.invoke("JoinRideGroup", rideId);
                })
                .catch(err => console.error('SignalR connection error:', err));
        }

        function startChatConnection(rideId) {
            if (chatConnection) {
                chatConnection.invoke("JoinRideChat", rideId)
                    .catch(err => console.error('Error joining chat group:', err));
                return;
            }

            chatConnection = new signalR.HubConnectionBuilder()
                .withUrl(`/chatHub?rideId=${rideId}`, {
                    accessTokenFactory: () => getJwtToken()
                })
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Information)
                .build();

            chatConnection.on("ConnectionEstablished", (message) => {
                console.log("Chat connection established:", message);
                showConnectionStatus("Chat connected successfully");
            });

            chatConnection.on("ConnectionError", (message) => {
                console.error("Chat connection error:", message);
                showConnectionStatus("Chat connection error: " + message, true);
            });

            chatConnection.on("ReceiveMessage", (message) => {
                console.log("Received message:", message);
                appendMessage({
                    senderName: message.senderName,
                    message: message.message,
                    timestamp: message.timestamp,
                    isDriver: message.isDriver
                }, message.senderId === userId);
            });

            chatConnection.on("LoadChatHistory", (messages) => {
                console.log("Loaded chat history:", messages);
                const chatMessages = document.getElementById("chatMessages");
                chatMessages.innerHTML = messages.length ? "" : "<p>No previous messages</p>";

                messages.forEach(m => {
                    appendMessage({
                        senderName: m.IsCurrentUser ? "You" : (m.IsDriver ? "Driver" : "Passenger"),
                        message: m.Message,
                        timestamp: m.Timestamp,
                        isDriver: m.IsDriver
                    }, m.IsCurrentUser);
                });
            });

            chatConnection.onclose(() => {
                console.log("Chat connection closed");
                showConnectionStatus("Chat disconnected", true);
            });

            chatConnection.start()
                .then(() => {
                    console.log("Chat connected");
                    return chatConnection.invoke("GetChatHistory", rideId);
                })
                .catch(err => {
                    console.error('Chat connection error:', err);
                    showConnectionStatus("Chat connection failed: " + err, true);
                    setTimeout(() => startChatConnection(rideId), 5000);
                });
        }

        function getJwtToken() {
            return document.cookie.match('(^|;)\\s*jwt\\s*=\\s*([^;]+)')?.pop() ||
                   localStorage.getItem('jwtToken') || '';
        }

        function appendMessage(message, isCurrentUser) {
            const chatMessages = document.getElementById("chatMessages");
            const messageElement = document.createElement("div");
            messageElement.className = `chat-message ${isCurrentUser ? 'from-driver' : 'from-passenger'}`;

            messageElement.innerHTML = `
                <div class="message-sender">${message.senderName}</div>
                <div class="message-text">${message.message}</div>
                <div class="message-time">${message.timestamp}</div>
            `;

            chatMessages.appendChild(messageElement);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function sendMessage() {
            const input = document.getElementById("chatInput");
            const message = input.value.trim();

            if (!message || !currentRideId) {
                return;
            }

            if (!chatConnection || chatConnection.state !== signalR.HubConnectionState.Connected) {
                alert("Chat connection not established. Please wait...");
                return;
            }

            chatConnection.invoke("SendMessage", currentRideId, message)
                .then(() => {
                    input.value = "";
                })
                .catch(err => {
                    console.error("Send failed:", err);
                    alert("Failed to send message. Please try again.");
                });
        }

        async function checkActiveRide() {
            try {
                const res = await fetch('/Ride/GetDriverActiveRide');
                if (res.ok) {
                    const ride = await res.json();
                    if (ride) {
                        currentRideId = ride.rideID;
                        document.getElementById('rideStatus').innerHTML =
                            `<span class="status-badge status-inprogress">🚕 Ride Status: ${ride.status}</span>`;
                        document.getElementById('activeRideControls').style.display = 'block';
                        document.getElementById('chatSection').style.display = 'block';

                        startSignalR(ride.rideID);
                        startChatConnection(ride.rideID);
                    }
                }
            } catch (error) {
                console.error('Error checking active ride:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            loadAvailableRides();
            document.getElementById('completeRideBtn').addEventListener('click', completeRide);
            document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
            document.getElementById('chatInput').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') sendMessage();
            });
            checkActiveRide();
        });
    </script>
</body>
</html>